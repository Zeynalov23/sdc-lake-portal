# Copy to .env and fill in. .env is gitignored - never commit real values.
#
#   cp .env.example .env
#   cd infra/infra-persistent && terraform output
AWS_REGION=eu-west-1
AWS_PROFILE=default
RESOURCE_PREFIX=sdc-lake-dev

# terraform output dynamodb_table_name
DYNAMODB_TABLE=sdc-lake-dev-resources
# terraform output sqs_queue_url
SQS_QUEUE_URL=

# terraform output entra_tenant_id / entra_client_id
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# The one real secret here. Never commit it.
ENTRA_CLIENT_SECRET=
