# Copy to .env and fill in. .env is gitignored - never commit real values.
#
#   cp .env.example .env
#   cd infra/infra-persistent && terraform output
AWS_REGION=eu-west-1
# AWS_PROFILE is read by scripts/aws-creds.sh on the HOST, not in the
# container. Set it in your shell if you do not use the default profile.
RESOURCE_PREFIX=sdc-lake-dev

# terraform output dynamodb_table_name
DYNAMODB_TABLE=sdc-lake-dev-resources
# terraform output sqs_queue_url
SQS_QUEUE_URL=

# terraform output entra_tenant_id / entra_client_id
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# The one real secret here. Never commit it.
ENTRA_CLIENT_SECRET=

# The Entra client secret. Required for login and for the directory lookup
# that turns an email into an object id. Never commit a real value.
# Add this redirect URI to the app registration first:
#   http://localhost:3000/api/auth/callback/entra
